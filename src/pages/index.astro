---
import Base from "../layouts/Base.astro";
import { site, hero, footerLinks } from "../site";

const isExternal = (href?: string) => !!href && href.startsWith("http");
const extAttrs = (href?: string) =>
  isExternal(href) ? { target: "_blank", rel: "noreferrer noopener" } : {};
---

<Base>
  <nav class="nav">
    <a class="nav-link" href="/">{site.name}</a>
  </nav>

  <main class="page">
    <section id="header" class="header">
      {hero.map((line) => (
        <p class="hero-line">{line.map((span) => (span.href ? <a class="link" href={span.href} {...extAttrs(span.href)}>{span.text.split(/(parc)/).map((part) => (part === "parc" ? <span class="parc">{part}</span> : part))}</a> : span.text))}</p>
      ))}
    </section>
  </main>

  <footer class="footer">
    <div class="footer-content">
      <p class="footer-links">{footerLinks.map((link, i) => (<Fragment>{i > 0 ? "; " : ""}<a class="link" href={link.href} {...extAttrs(link.href)}>{link.text}</a></Fragment>))}</p>
      <p class="tagline">{site.tagline}</p>
    </div>
  </footer>
</Base>
