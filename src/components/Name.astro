---
interface Props {
  main: string;
  sub?: string;
}

const { main, sub = main } = Astro.props;
const letters = (word: string) =>
  word.split("").map((c) => (c === " " ? "\u00A0" : c));
---

<span class="name">
  <span class="sr-only">{main}</span>
  <span class="name-inner" aria-hidden="true">
    <span class="name-main">
      {letters(main).map((c, i) => <span class="ltr" style={`--i:${i}`}>{c}</span>)}
    </span>
    <span class="name-sub">
      {letters(sub).map((c, i) => <span class="ltr" style={`--i:${i}`}>{c}</span>)}
    </span>
  </span>
</span>

<style>
  .name {
    display: inline-block;
    font-weight: 500;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .name-inner {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .name-main {
    display: inline-block;
  }

  .name-sub {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-block;
  }

  .ltr {
    display: inline-block;
    transition: transform 0.35s ease-in-out;
    transition-delay: calc(var(--i) * 30ms);
  }

  .name-sub .ltr {
    transform: translateY(100%);
  }

  .name:hover .name-main .ltr {
    transform: translateY(-100%);
  }

  .name:hover .name-sub .ltr {
    transform: translateY(0);
  }
</style>
